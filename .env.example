# ===========================================
# Don Nicolás RFID — Variables de entorno
# Copiar a .env y completar valores
# ===========================================

# --- Base de datos ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=don_nicolas_rfid
POSTGRES_USER=rfid_admin
POSTGRES_PASSWORD=changeme

# --- API Backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
SECRET_KEY=generar-clave-segura-aqui
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Frontend (puerto 5174 — el 5173 suele estar ocupado por otros proyectos) ---
VITE_PORT=5174
VITE_API_URL=http://localhost:8000/api/v1

# --- Almacenamiento de archivos ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Impresora Zebra ---
ZEBRA_PRINTER_HOST=192.168.1.100
ZEBRA_PRINTER_PORT=9100

# --- CORS (desarrollo) ---
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000
