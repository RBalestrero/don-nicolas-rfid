# ===========================================
# Don Nicolás RFID — Variables de entorno
# Copiar a .env y completar valores
# ===========================================

# --- Entorno ---
# development | production
APP_ENV=development
# Docs OpenAPI: vacío = automático (on en development, off en production)
# EXPOSE_API_DOCS=true

# --- Base de datos ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=don_nicolas_rfid
POSTGRES_USER=rfid_admin
POSTGRES_PASSWORD=changeme

# --- API Backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
# En producción: >=32 chars, sin valores de ejemplo
SECRET_KEY=generar-clave-segura-aqui-con-al-menos-32c
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting / lockout
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300

# --- Frontend (puerto 5174 — el 5173 suele estar ocupado por otros proyectos) ---
VITE_PORT=5174
VITE_API_URL=http://localhost:8000/api/v1
# VITE_API_TIMEOUT_MS=20000

# --- Almacenamiento de archivos ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_REQUEST_BODY_MB=12

# --- Impresora Zebra ---
ZEBRA_PRINTER_HOST=192.168.1.100
ZEBRA_PRINTER_PORT=9100
ZEBRA_PRINTER_SIMULATE=true
ZEBRA_PRINTER_TIMEOUT=5

# --- CORS (desarrollo) ---
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# Clientes autorizados para writes de inventarios
INVENTORY_MOBILE_CLIENTS=mc33,mc33-apk
