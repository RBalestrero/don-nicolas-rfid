# ===========================================
# Don Nicolás RFID — Variables de entorno
# Copiar a .env y completar valores
# ===========================================

# --- Entorno ---
# development | production
APP_ENV=development
# Docs OpenAPI: vacío = automático (on en development, off en production)
# EXPOSE_API_DOCS=true

# --- Base de datos ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=don_nicolas_rfid
# Pytest local usa automáticamente don_nicolas_rfid_test (no contamina esta BD).
# POSTGRES_TEST_DB=don_nicolas_rfid_test
POSTGRES_USER=rfid_admin
POSTGRES_PASSWORD=changeme

# --- API Backend ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
# En producción: >=32 chars aleatorios. NO uses este placeholder (está bloqueado).
SECRET_KEY=dev-only-local-not-for-production-use-xx
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting / lockout
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=300
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
# Solo true detrás de nginx/proxy que sanee X-Forwarded-For
TRUST_X_FORWARDED_FOR=false

# --- Frontend (puerto 5174 — el 5173 suele estar ocupado por otros proyectos) ---
VITE_PORT=5174
VITE_API_URL=http://localhost:8000/api/v1
# VITE_API_TIMEOUT_MS=20000

# --- Almacenamiento de archivos ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
MAX_REQUEST_BODY_MB=12

# --- Impresora Zebra ---
ZEBRA_PRINTER_HOST=192.168.1.20
ZEBRA_PRINTER_PORT=9100
ZEBRA_PRINTER_SIMULATE=true
ZEBRA_PRINTER_TIMEOUT=5

# --- CORS (desarrollo) ---
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:3000

# Presencia MC33 en dashboard (segundos sin heartbeat = offline)
DEVICE_ONLINE_TIMEOUT_SECONDS=180

# Clientes autorizados para writes de inventarios (header X-Client)
INVENTORY_MOBILE_CLIENTS=mc33,mc33-apk
# Opcional: secreto compartido APK↔API (header X-Inventory-Client-Secret).
# Si está vacío, solo se exige X-Client. En producción se recomienda definir uno.
# INVENTORY_CLIENT_SECRET=